---
import { getImage, Image, Picture } from 'astro:assets';
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/wght-italic.css';
import '@fontsource-variable/manrope';
import '../styles.css';
import saunaExterior from '../assets/sauna-proba-lampa.png';
import socialPhoto from '../assets/sauna-z-dowozem-refleks.png';
import deliveryMap from '../assets/mapa-dowozu.jpg';
import logo from '../assets/logo-mobilna-sauna.png';
import Gallery from '../components/Gallery.astro';
import ProfileLinks from '../components/ProfileLinks.astro';


const canonical = Astro.site && new URL(Astro.url.pathname, Astro.site);
const contactNumber = canonical ? import.meta.env.BOOKING_PHONE?.trim() || '' : '';
const phoneDigits = contactNumber.replace(/[^\d+]/g, '');
const phoneParts = phoneDigits.match(/^\+48(\d{3})(\d{3})(\d{3})$/);
const phoneHref = phoneParts ? `tel:${phoneDigits}` : '';
const phoneLabel = phoneParts ? `(+48) ${phoneParts.slice(1).join(' ')}` : '(+48) XXX XXX XXX';
if (canonical && !phoneHref) throw new Error('Set BOOKING_PHONE to a public Polish booking number with the +48 prefix.');

const title = 'Mobilna sauna z dowozem | Swarzewo, Puck, Władysławowo';
const description = 'Wynajmij mobilną saunę opalaną drewnem na wieczór lub weekend. Dowozimy do Swarzewa, Pucka, Władysławowa i okolic, a piec rozpalamy na miejscu.';
const socialImage = await getImage({ src: socialPhoto, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 86 });
const socialAlt = 'Drewniana sauna na przyczepie nad Zatoką Pucką w zimowym słońcu';
const sharePage = canonical || (import.meta.env.PREVIEW_URL && new URL(Astro.url.pathname, import.meta.env.PREVIEW_URL));
const shareImageUrl = sharePage ? new URL(socialImage.src, sharePage).href : socialImage.src;
const rentalPrices = [
  { duration: '1 noc', total: 400 },
  { duration: '2 noce', total: 700 },
  { duration: '3 noce', total: 900 },
  { duration: '4 noce', total: 1000 },
];
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f3eb" />
    <title>{title}</title>
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-sauna.png" />
    {canonical ? <link rel="canonical" href={canonical.href} /> : <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content="Mobilne Saunowanie" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {sharePage && <meta property="og:url" content={sharePage.href} />}
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImageUrl} />
    <meta name="twitter:image:alt" content={socialAlt} />
  </head>
  <body>
    <a class="skip-link" href="#tresc">Przejdź do treści</a>
    <header class="site-header frame">
      <a class="brand" href="#start" aria-label="Mobilne Saunowanie — początek strony">
        <Image src={logo} width={144} format="png" loading="eager" alt="" />
      </a>
      <nav aria-label="Menu główne">
        <a href="#oferta">Oferta</a>
        <a href="#galeria">Galeria</a>
        <a class="nav-contact" href="#kontakt">Kontakt</a>
        <ProfileLinks />
      </nav>
    </header>

    <main id="tresc">
      <section class="hero frame" id="start" aria-labelledby="hero-title">
        <div class="hero-content">
          <p class="eyebrow"><span class="rule" aria-hidden="true"></span>Swarzewo i okolice</p>
          <h1 id="hero-title">Mobilna sauna <em>z dowozem.</em></h1>
          <p class="hero-description">Wynajmij saunę na wieczór lub weekend. Dowozimy do Swarzewa, Pucka, Władysławowa i okolic, a piec rozpalamy na miejscu.</p>
          <a class="button" href="#oferta">Sprawdź ofertę</a>
        </div>
        <figure class="hero-photo">
          <Picture src={saunaExterior} formats={['webp']} fallbackFormat="png" width={1440} widths={[560, 800, 1080, 1440]}
            sizes="(max-width: 720px) 150vw, 90vw" loading="eager" fetchpriority="high"
            alt="Drewniana sauna na przyczepie nad zaśnieżonym brzegiem zatoki" />
        </figure>
      </section>

      <section class="offer" id="oferta" aria-labelledby="offer-title">
        <div class="frame offer-grid">
          <div class="offer-content">
            <h2 id="offer-title">Saunowanie u siebie</h2>
            <p class="offer-intro">Sauna mieści <strong>maksymalnie 10 osób</strong>. Dla większego komfortu polecamy grupę do <strong>8 osób</strong>. Możesz ją wynająć na jeden wieczór albo na kilka dni.</p>
            <dl class="rental-steps">
              <div>
                <dt>Przywozimy i rozpalamy</dt>
                <dd>Podstawiamy saunę pod wskazany adres i rozpalamy piec opalany drewnem.</dd>
              </div>
              <div>
                <dt>Odbieramy rano</dt>
                <dd>Po ostatniej nocy wynajmu przyjeżdżamy rano po saunę.</dd>
              </div>
              <div>
                <dt>Opał w cenie</dt>
                <dd>Przywozimy zapas drewna na cały pobyt, pociętego i gotowego do palenia.</dd>
              </div>
            </dl>
          </div>
          <section class="pricing" aria-labelledby="pricing-title">
            <h3 id="pricing-title">Cennik wynajmu</h3>
            <p class="pricing-intro">Ceny za wynajem całej sauny na wybrany okres. Rozpalenie pieca i drewno są w cenie.</p>
            <dl class="price-list">
              {rentalPrices.map(({ duration, total }) => (
                <div class="price-row">
                  <dt>{duration}</dt>
                  <dd>{total.toLocaleString('pl-PL', { useGrouping: 'always' })}&nbsp;zł</dd>
                </div>
              ))}
            </dl>
            <p class="pricing-note">W noc sylwestrową, w święta i długie weekendy stawka może być wyższa. Cenę potwierdzimy przy ustalaniu terminu.</p>
            <div class="pricing-delivery">
              <h4>Koszt dowozu</h4>
              <p>W promieniu około <strong>10 km od Swarzewa</strong> dowóz jest bezpłatny. Dalej doliczamy <strong>5 zł za każdy dodatkowy kilometr</strong>.</p>
              <details class="delivery-area">
                <summary>Mapa darmowego dowozu</summary>
                <p>Mapa pokazuje orientacyjny zasięg darmowego dowozu. Koszt dowozu pod Twój adres potwierdzimy przy rezerwacji.</p>
                <figure class="delivery-map">
                  <Image src={deliveryMap} format="webp" width={1200} widths={[480, 780, 1200]}
                    sizes="(max-width: 720px) 100vw, 47vw" alt="Orientacyjna strefa darmowego dowozu wokół Swarzewa, obejmująca m.in. Puck i Władysławowo" />
                </figure>
              </details>
            </div>
          </section>
        </div>
      </section>

      <Gallery />

      <section class="contact" id="kontakt" aria-labelledby="contact-title">
        <div class="frame">
          <h2 id="contact-title">Umów saunowanie</h2>
          <p>{phoneHref ? 'Zadzwoń i podaj termin oraz miejscowość. Ustalimy dostępność i szczegóły dowozu.' : 'Przykładowy wygląd przycisku kontaktu.'}</p>
          <a class="button contact-button" href={phoneHref || undefined}>
            <span>Zadzwoń</span>
            <span class="contact-number">{phoneLabel}</span>
          </a>
        </div>
      </section>
    </main>

    <footer class="frame site-footer">
      <span>Mobilne Saunowanie · Swarzewo</span>
      <a class="footer-privacy" href="/przetwarzanie-danych/">Dane przy rezerwacji</a>
      <ProfileLinks />
    </footer>

    <a class="mobile-contact" href="#kontakt">Kontakt</a>

    <script is:inline>
      (() => {
        const contact = document.getElementById('kontakt');
        const shortcut = document.querySelector('.mobile-contact');
        new IntersectionObserver(([entry]) => {
          shortcut.classList.toggle('is-hidden', entry.intersectionRatio >= 0.2);
        }, { threshold: 0.2 }).observe(contact);

        let frame;
        const stop = () => cancelAnimationFrame(frame);

        window.addEventListener('wheel', stop, { passive: true });
        window.addEventListener('touchstart', stop, { passive: true });
        window.addEventListener('popstate', stop);
        window.addEventListener('keydown', (event) => {
          if (['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', ' '].includes(event.key)) stop();
        });

        document.querySelectorAll('a[href^="#"]:not(.skip-link)').forEach((link) => {
          link.addEventListener('click', (event) => {
            if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
            const hash = link.getAttribute('href');
            const target = document.getElementById(hash.slice(1));
            if (!target) return;

            event.preventDefault();
            stop();
            if (location.hash !== hash) history.pushState(null, '', hash);

            const start = window.scrollY;
            const margin = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
            const max = document.scrollingElement.scrollHeight - window.innerHeight;
            const end = Math.max(0, Math.min(max, start + target.getBoundingClientRect().top - margin));
            if (event.detail === 0) {
              target.setAttribute('tabindex', '-1');
              target.focus({ preventScroll: true });
            }
            if (Math.abs(end - start) < 1) return;

            const startedAt = performance.now();
            const duration = 450;
            function animate(now) {
              const progress = Math.min(1, (now - startedAt) / duration);
              const eased = (1 - Math.cos(Math.PI * progress)) / 2;
              window.scrollTo(0, start + (end - start) * eased);
              if (progress < 1) frame = requestAnimationFrame(animate);
            }
            frame = requestAnimationFrame(animate);
          });
        });
      })();
    </script>
  </body>
</html>
